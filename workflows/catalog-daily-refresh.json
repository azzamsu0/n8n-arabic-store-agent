      "parameters": {
        "jsCode": "const res = await this.helpers.httpRequest({ method: \"GET\", url: \"http://qdrant:6333/collections/store_products\", json: true });\nconst n = (res && res.result && res.result.points_count) || 0;\nconst MIN = 250;\nif (n < MIN) {\n  throw new Error(\"فشل بناء الكتالوج: Qdrant فيها \" + n + \" نقطة فقط بعد التحديث (الحد الأدنى \" + MIN + \").\");\n}\nreturn [{ json: { points: n, finishedAt: new Date().toISOString() } }];"
      },
