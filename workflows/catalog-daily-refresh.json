    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst MIN = 250;\nif (items.length < MIN) {\n  throw new Error(\"الشيت رجّع \" + items.length + \" صفاً فقط (الحد الأدنى \" + MIN + \"). أُلغي التحديث، والكتالوج القديم باقٍ كما هو.\");\n}\nawait this.helpers.httpRequest({ method: \"DELETE\", url: \"http://qdrant:6333/collections/store_products\" });\nreturn items;"
      },
